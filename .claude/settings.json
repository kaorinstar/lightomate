{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-main.sh\" SessionStart",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-main.sh\" PreToolUse",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-cd-git.mjs\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(cat *)",
      "Bash(cd *)",
      "Bash(cp *)",
      "Bash(diff *)",
      "Bash(echo *)",
      "Bash(find:*)",
      "Bash(gh *)",
      "Bash(git *)",
      "Bash(grep:*)",
      "Bash(head *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(pwd)",
      "Bash(rm *)",
      "Bash(sed *)",
      "Bash(tail *)",
      "Bash(tree *)",
      "Bash(wc *)",
      "Skill(git-commit)",
      "Skill(git-commit:*)",
      "WebFetch",
      "WebSearch"
    ],
    "ask": [
      "Bash(find * -delete*)",
      "Bash(find * -exec *)",
      "Bash(gh api *DELETE*)",
      "Bash(gh issue delete:*)",
      "Bash(gh label delete *)",
      "Bash(gh pr merge:*)",
      "Bash(gh release delete *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit*)",
      "Bash(git branch -D*)",
      "Bash(git checkout -- *)",
      "Bash(git clean *)",
      "Bash(git push * -f*)",
      "Bash(git push *--delete*)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard:*)",
      "Bash(git stash clear*)",
      "Bash(git stash drop*)",
      "Bash(rm * ..*)",
      "Bash(rm * .git*)",
      "Bash(rm * /*)",
      "Bash(rm * ~*)",
      "Bash(rm ..*)",
      "Bash(rm .git*)",
      "Bash(rm /*)",
      "Bash(rm ~*)"
    ],
    "deny": [
      "Bash(cat *.env *)",
      "Bash(cat *.env)",
      "Bash(cat *.env.local *)",
      "Bash(cat *.env.local)",
      "Bash(cat *.env.production *)",
      "Bash(cat *.env.production)",
      "Bash(grep *.env *)",
      "Bash(grep *.env)",
      "Bash(grep *.env.*.local *)",
      "Bash(grep *.env.*.local)",
      "Bash(grep *.env.development *)",
      "Bash(grep *.env.development)",
      "Bash(grep *.env.local *)",
      "Bash(grep *.env.local)",
      "Bash(grep *.env.production *)",
      "Bash(grep *.env.production)",
      "Bash(grep *.env.staging *)",
      "Bash(grep *.env.staging)",
      "Bash(grep *.env.test *)",
      "Bash(grep *.env.test)",
      "Bash(head *.env *)",
      "Bash(head *.env)",
      "Bash(head *.env.local *)",
      "Bash(head *.env.local)",
      "Bash(head *.env.production *)",
      "Bash(head *.env.production)",
      "Bash(less *.env *)",
      "Bash(less *.env)",
      "Bash(less *.env.*.local *)",
      "Bash(less *.env.*.local)",
      "Bash(less *.env.development *)",
      "Bash(less *.env.development)",
      "Bash(less *.env.local *)",
      "Bash(less *.env.local)",
      "Bash(less *.env.production *)",
      "Bash(less *.env.production)",
      "Bash(less *.env.staging *)",
      "Bash(less *.env.staging)",
      "Bash(less *.env.test *)",
      "Bash(less *.env.test)",
      "Bash(sed *.env *)",
      "Bash(sed *.env)",
      "Bash(sed *.env.local *)",
      "Bash(sed *.env.local)",
      "Bash(sed *.env.production *)",
      "Bash(sed *.env.production)",
      "Bash(tail *.env *)",
      "Bash(tail *.env)",
      "Bash(tail *.env.local *)",
      "Bash(tail *.env.local)",
      "Bash(tail *.env.production *)",
      "Bash(tail *.env.production)",
      "Read(.env)",
      "Read(.env.*.local)",
      "Read(.env.development)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Read(.env.staging)",
      "Read(.env.test)"
    ]
  }
}
