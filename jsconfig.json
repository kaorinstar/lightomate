{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["chrome", "node"],
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "extension/**/*.js",
    "test/**/*.js",
    "e2e/*.js",
    "scripts/**/*.js",
    "eslint.config.js"
  ]
}
