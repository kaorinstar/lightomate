{
  "name": "lightomate",
  "private": true,
  "type": "module",
  "description": "Web 上の操作を自動化する Chrome 拡張機能（開発用の設定です。拡張機能の本体は extension/ にあります）",
  "license": "MIT",
  "scripts": {
    "vendor": "node scripts/vendor.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p jsconfig.json",
    "test": "node --test",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tabler/core": "^1.6.0",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
